generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Society {
  id                 String    @id @default(cuid())
  name               String
  address            String
  city               String
  state              String    @default("Gujarat")
  pinCode            String?
  latitude           Float?
  longitude          Float?
  mapAddress         String?
  subscriptionStatus String    @default("ACTIVE")
  planType           String    @default("STARTER")
  monthlyAmount      Float     @default(499)
  demoOtpCode        String?
  subscriptionStart  DateTime  @default(now())
  subscriptionEnd    DateTime?
  trialEndsAt        DateTime?
  autoRenew          Boolean   @default(true)
  notes              String?
  subAdminId         String?
  subAdmin           SubAdmin? @relation("SubAdminSocieties", fields: [subAdminId], references: [id])
  createdAt          DateTime  @default(now())
  wings              Wing[]
  payments           SubscriptionPayment[]
}

model SubscriptionPayment {
  id        String   @id @default(cuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id])
  amount    Float
  month     Int
  year      Int
  paidAt    DateTime @default(now())
  method    String   @default("UPI")
  reference String?
  notes     String?
  createdAt DateTime @default(now())
}

model SubAdmin {
  id           String       @id @default(cuid())
  name         String
  phone        String       @unique
  email        String?
  password     String
  role         SubAdminRole @default(AREA_PARTNER)
  region       String
  regionType   String
  parentId     String?
  parent       SubAdmin?    @relation("SubAdminHierarchy", fields: [parentId], references: [id])
  children     SubAdmin[]   @relation("SubAdminHierarchy")
  societies    Society[]    @relation("SubAdminSocieties")
  commissionPct Float       @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?
}

enum SubAdminRole {
  STATE_ADMIN
  CITY_ADMIN
  AREA_PARTNER
  CUSTOM
}

model Wing {
  id          String      @id @default(cuid())
  name        String
  societyId   String
  isActive    Boolean     @default(true)
  trialEndsAt DateTime?
  society     Society     @relation(fields: [societyId], references: [id])
  flats      Flat[]
  users      User[]
  notices    Notice[]
  complaints Complaint[]
  visitors   Visitor[]
  utilityServices UtilityService[]
  vendors    Vendor[]
  resaleListings ResaleListing[]
  guestInvites GuestInvite[]
  emergencyAlerts EmergencyAlert[]
  amenities  Amenity[]
  lateFeeAmount    Float @default(0)
  lateFeeGraceDays Int   @default(5)
  createdAt  DateTime    @default(now())
}

model Flat {
  id            String            @id @default(cuid())
  number        String
  floor         Int
  sqftSize      Int?
  familyMembers Int               @default(0)
  wingId        String
  wing          Wing              @relation(fields: [wingId], references: [id])
  users         User[]
  bills         MaintenanceBill[]
  vehicles      Vehicle[]
  domesticHelp  DomesticHelp[]
  resaleListings ResaleListing[]
  guestInvites  GuestInvite[]
  emergencyAlerts EmergencyAlert[]
  amenityBookings AmenityBooking[]
  createdAt     DateTime          @default(now())
}

model User {
  id        String    @id @default(cuid())
  name         String
  phone        String        @unique
  role          Role          @default(RESIDENT)
  residentType  ResidentType?
  leaseStart    DateTime?
  leaseEnd      DateTime?
  familyMembers Int           @default(1)
  isPrimary     Boolean       @default(false)
  guardPin      String?
  upiId         String?
  societyId     String?
  wingId       String?
  flatId       String?
  wing         Wing?         @relation(fields: [wingId], references: [id])
  flat         Flat?         @relation(fields: [flatId], references: [id])
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  sessions     Session[]
  vaultDocuments VaultDocument[]
  resaleListings ResaleListing[] @relation("ListingCreatedBy")
  reviewedListings ResaleListing[] @relation("ListingReviewedBy")
  guestInvitesCreated GuestInvite[]
  raisedAlerts EmergencyAlert[] @relation("AlertRaisedBy")
  resolvedAlerts EmergencyAlert[] @relation("AlertResolvedBy")
  amenityBookings AmenityBooking[]
  familyRelation String?
  notifications  Notification[]
  // Id of the most recent login; older tokens are rejected (one device per person).
  sessionId      String?

  // ── PIN login ──────────────────────────────────────────────────────────────
  // Both the PIN and the one-time activation code are stored hashed only.
  pinHash             String?
  pinSetAt            DateTime?
  activationCodeHash  String?
  activationExpiresAt DateTime?
  pinFailedAttempts   Int       @default(0)
  pinLockedUntil      DateTime?
  // Expo push token of the phone this person is signed in on (one device per person).
  pushToken           String?
  // Tokens issued before this moment are rejected (set on PIN reset / change).
  sessionsValidAfter  DateTime?
}

enum ResidentType {
  OWNER
  TENANT
}

enum Role {
  SUPER_ADMIN
  WING_ADMIN
  RESIDENT
  GUARD
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  deviceId     String
  sessionToken String
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
}

model MaintenanceBill {
  id          String       @id @default(cuid())
  flatId      String
  flat        Flat         @relation(fields: [flatId], references: [id])
  wingId      String
  amount      Float
  month       Int
  year        Int
  dueDate     DateTime
  status      BillStatus   @default(PENDING)
  paidAt      DateTime?
  paymentMode PaymentMode?
  receiptUrl  String?
  proofPublicId     String?
  proofResourceType String?
  proofFormat       String?
  lateFeeApplied    Float        @default(0)
  createdAt   DateTime     @default(now())

  @@unique([flatId, month, year])
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  PENDING_VERIFICATION
}

enum PaymentMode {
  UPI
  CASH
  CHEQUE
}

model Notice {
  id        String         @id @default(cuid())
  wingId    String
  wing      Wing           @relation(fields: [wingId], references: [id])
  title     String
  body      String?
  category  NoticeCategory
  audience  String         @default("ALL")
  targetFlatId String?
  targetFloor  Int?
  photoUrl  String?
  createdAt DateTime       @default(now())
  seenBy    NoticeSeen[]
}

enum NoticeCategory {
  MEETING
  WATER
  EVENT
  MAINTENANCE
  OTHER
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String
  relatedId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model NoticeSeen {
  id       String   @id @default(cuid())
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id])
  userId   String
  seenAt   DateTime @default(now())

  @@unique([noticeId, userId])
}

model Complaint {
  id          String            @id @default(cuid())
  wingId      String
  wing        Wing              @relation(fields: [wingId], references: [id])
  flatId      String
  userId      String
  category    ComplaintCategory
  location    String
  description String?
  photoUrl    String?
  status      ComplaintStatus   @default(OPEN)
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
}

enum ComplaintCategory {
  PLUMBING
  ELECTRICAL
  LIFT
  CLEANING
  SECURITY
  LOST_FOUND
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Visitor {
  id               String            @id @default(cuid())
  wingId           String
  wing             Wing              @relation(fields: [wingId], references: [id])
  flatId           String
  visitorName      String
  photoUrl         String?
  purpose          String?
  deliveryHandling DeliveryHandling?
  approvedBy       String?
  status           VisitorStatus     @default(PENDING)
  entryTime        DateTime?
  exitTime         DateTime?
  createdAt        DateTime          @default(now())
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
}

enum DeliveryHandling {
  CABIN_DROP
  HELPER_DELIVERY
  DIRECT_DELIVERY
}

model Vehicle {
  id          String      @id @default(cuid())
  flatId      String
  flat        Flat        @relation(fields: [flatId], references: [id], onDelete: Cascade)
  wingId      String
  type        VehicleType
  plateNumber String
  createdAt   DateTime    @default(now())
}

enum VehicleType {
  BIKE
  CAR
  AUTO
  OTHER
}

model UtilityService {
  id               String              @id @default(cuid())
  wingId           String
  wing             Wing                @relation(fields: [wingId], references: [id])
  category         UtilityCategory
  name             String
  assignedToName   String?
  assignedToPhone  String?
  frequency        UtilityFrequency    @default(MONTHLY)
  scheduleDays     String[]            @default([])
  estimatedCost    Float?
  status           UtilityStatus       @default(ACTIVE)
  notes            String?
  createdAt        DateTime            @default(now())
  logs             UtilityServiceLog[]
}

enum UtilityCategory {
  WATER
  DRAINAGE
  GARDEN
  ELECTRICITY
  PARKING
  OTHER
}

enum UtilityFrequency {
  ONCE
  WEEKLY
  MONTHLY
}

enum UtilityStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model UtilityServiceLog {
  id               String          @id @default(cuid())
  utilityServiceId String
  utilityService   UtilityService  @relation(fields: [utilityServiceId], references: [id], onDelete: Cascade)
  completedAt      DateTime        @default(now())
  amountPaid       Float?
  paymentMode      PaymentMode?
  recordedBy       String?
  createdAt        DateTime        @default(now())
}

model VaultDocument {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType            DocType
  fileName           String
  mimeType           String
  cloudinaryPublicId String
  resourceType       String
  format             String?
  notes              String?
  createdAt          DateTime @default(now())
}

enum DocType {
  AADHAAR
  PAN
  SALE_DEED
  RENT_AGREEMENT
  PROPERTY_TAX
  OTHER
}

model Vendor {
  id        String        @id @default(cuid())
  wingId    String
  wing      Wing          @relation(fields: [wingId], references: [id])
  category  VendorCategory
  name      String
  phone     String
  notes     String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  jobs      VendorJob[]
}

enum VendorCategory {
  PLUMBER
  ELECTRICIAN
  CLEANER
  GARDENER
  CONTRACTOR
  OTHER
}

model VendorJob {
  id           String        @id @default(cuid())
  vendorId     String
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  description  String
  status       VendorJobStatus @default(ASSIGNED)
  cost         Float?
  paymentMode  PaymentMode?
  assignedAt   DateTime      @default(now())
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
}

enum VendorJobStatus {
  ASSIGNED
  COMPLETED
}

model DomesticHelp {
  id        String            @id @default(cuid())
  flatId    String
  flat      Flat              @relation(fields: [flatId], references: [id], onDelete: Cascade)
  wingId    String
  name      String
  phone     String
  role      DomesticHelpRole
  notes     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
}

enum DomesticHelpRole {
  MAID
  COOK
  DRIVER
  NANNY
  WATCHMAN
  OTHER
}

model ResaleListing {
  id              String        @id @default(cuid())
  wingId          String
  wing            Wing          @relation(fields: [wingId], references: [id])
  flatId          String
  flat            Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User          @relation("ListingCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  listingType     ListingType
  bhkType         String
  carpetArea      Int?
  price           Float
  description     String
  contactPhone    String
  status          ListingStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?         @relation("ListingReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  photos          ResaleListingPhoto[]
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

model ResaleListingPhoto {
  id        String        @id @default(cuid())
  listingId String
  listing   ResaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  publicId  String
  url       String
  createdAt DateTime      @default(now())
}

model GuestInvite {
  id              String            @id @default(cuid())
  wingId          String
  wing            Wing              @relation(fields: [wingId], references: [id])
  flatId          String
  flat            Flat              @relation(fields: [flatId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  guestName       String
  guestPhone      String?
  purpose         String?
  visitDate       DateTime
  otpCode         String
  status          GuestInviteStatus @default(PENDING)
  createdVisitorId String?
  usedAt          DateTime?
  createdAt       DateTime          @default(now())
}

enum GuestInviteStatus {
  PENDING
  USED
  CANCELLED
  EXPIRED
}

model EmergencyAlert {
  id           String      @id @default(cuid())
  wingId       String
  wing         Wing        @relation(fields: [wingId], references: [id])
  flatId       String
  flat         Flat        @relation(fields: [flatId], references: [id], onDelete: Cascade)
  raisedById   String
  raisedBy     User        @relation("AlertRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  status       AlertStatus @default(ACTIVE)
  resolvedById String?
  resolvedBy   User?       @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
}

enum AlertStatus {
  ACTIVE
  RESOLVED
}

model Amenity {
  id               String           @id @default(cuid())
  wingId           String
  wing             Wing             @relation(fields: [wingId], references: [id])
  name             String
  description      String?
  capacityPerSlot  Int              @default(1)
  slotMinutes      Int              @default(60)
  openTime         String
  closeTime        String
  requiresApproval Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  bookings         AmenityBooking[]
}

model AmenityBooking {
  id              String        @id @default(cuid())
  amenityId       String
  amenity         Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  flatId          String
  flat            Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  bookedById      String
  bookedBy        User          @relation(fields: [bookedById], references: [id], onDelete: Cascade)
  bookingDate     DateTime
  slotStart       String
  slotEnd         String
  status          BookingStatus @default(CONFIRMED)
  rejectionReason String?
  createdAt       DateTime      @default(now())

  @@unique([amenityId, bookingDate, slotStart, bookedById])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}
